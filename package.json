{
  "name": "performance-web-vitals-ra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:pagespeed-key": "tsx scripts/test-pagespeed-key.ts",
    "audit": "tsx src/index.ts",
    "audit:psi-api": "tsx src/index.ts --pagespeed-api-only",
    "auth:login": "tsx scripts/auth-login.ts",
    "audit-PageSpeedAPI": "REQUIRE_PAGESPEED_API=1 tsx src/index.ts",
    "audit-PageSpeedAPI:green": "REQUIRE_PAGESPEED_API=1 AUDIT_GREEN=1 tsx src/index.ts",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "chrome-launcher": "^1.1.2",
    "dotenv": "^17.3.1",
    "lighthouse": "^12.2.1",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
